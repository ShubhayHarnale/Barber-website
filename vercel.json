{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/bookings", "dest": "/api/bookings" },
    { "src": "/api/bookings/slots", "dest": "/api/bookings" },
    { "src": "/api/settings", "dest": "/api/settings" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
