{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/bookings", "destination": "/api/bookings" },
    { "source": "/api/bookings/:id", "destination": "/api/bookings" },
    { "source": "/api/bookings/slots/:date", "destination": "/api/bookings" },
    { "source": "/api/contact", "destination": "/api/contact" },
    { "source": "/api/settings", "destination": "/api/settings" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
